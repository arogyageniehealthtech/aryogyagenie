# Database Connection
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/arogyagenie"

# Clerk Authentication Keys (Get from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"
CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Server Ports (Optional, defaults applied if omitted)
PORT=3000

# ─── AI Configuration ──────────────────────────────────────────────────────────
#
# ArogyaGenie supports two AI providers. Set ONE of the following:
#
#  LOCAL DEVELOPMENT (Ollama):
#    Make sure Ollama is running with: ollama serve
#    Models needed: ollama pull llama3:8b && ollama pull nomic-embed-text
#
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:8b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
#
#  PRODUCTION / RENDER (Gemini):
#    Get a free API key at: https://aistudio.google.com/apikey
#    Gemini 1.5 Flash = free (1,500 req/day), text-embedding-004 = free (1M tokens/day)
#    When GEMINI_API_KEY is set, it takes priority over Ollama automatically.
#    After setting this, run: pnpm run rag:ingest  (to store Gemini vectors in the DB)
#
# GEMINI_API_KEY="AIzaSy..."
# GEMINI_MODEL="gemini-1.5-flash"

# CORS Origins (Comma-separated list for production, e.g. https://arogyagenie.onrender.com)
ALLOWED_ORIGINS=

