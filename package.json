{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "dev": "pnpm -r --parallel --filter \"./artifacts/**\" --if-present run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "pnpm --filter @workspace/scripts exec tsx ./src/seed.ts",
    "db:reset": "pnpm --filter @workspace/scripts exec tsx ./src/resetDb.ts",
    "admin:grant": "pnpm --filter @workspace/scripts exec tsx ./src/grantAdmin.ts",
    "rag:ingest": "npx tsx --tsconfig ./scripts/tsconfig.json ./scripts/src/ingestMedicalKnowledge.ts"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
