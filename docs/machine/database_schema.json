{
  "tables": [
    {
      "name": "users",
      "file": "lib/db/src/schema/users.ts",
      "columns": [
        "id (serial PK)", "clerkId (text unique)", "email (text unique)",
        "firstName", "lastName", "phone", "role (enum)", "status (enum)",
        "avatarUrl", "dateOfBirth", "gender", "address", "city", "state",
        "bloodGroup", "allergies", "emergencyContact", "createdAt", "updatedAt"
      ]
    },
    {
      "name": "doctors",
      "file": "lib/db/src/schema/doctors.ts",
      "columns": [
        "id (serial PK)", "userId (FK -> users.id)", "specialty", "qualification",
