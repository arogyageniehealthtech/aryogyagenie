        "experience", "bio", "rating", "reviewCount", "status", "availableDays",
        "availableHours", "createdAt", "updatedAt"
      ]
    },
    {
      "name": "appointments",
      "file": "lib/db/src/schema/appointments.ts",
      "columns": [
        "id (serial PK)", "patientId (FK)", "doctorId (FK)", "appointmentDate",
        "appointmentTime", "type (enum)", "status (enum)", "symptoms", "notes",
        "consultationFee", "createdAt", "updatedAt"
      ]
    },
    {
      "name": "prescriptions",
      "file": "lib/db/src/schema/prescriptions.ts",
      "columns": [
        "id (serial PK)", "patientId (FK)", "doctorId (FK)", "appointmentId (FK)",
